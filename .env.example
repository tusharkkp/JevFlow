# ==============================================================================
# JevFlow Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# TypeSafe / Jev Settings (System One Decision Layer)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_DEFAULT_MODEL=jev-latest
JEV_TIMEOUT_MS=1500

# Real Model Providers (OpenAI, Groq, OpenRouter, DeepSeek, Ollama)
# Leave OPENAI_API_KEY empty to use calibrated offline mock providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SMALL_MODEL_NAME=gpt-4o-mini
FRONTIER_MODEL_NAME=gpt-4o

# Policy Engine Thresholds
HIGH_CONFIDENCE_THRESHOLD=0.85
MEDIUM_CONFIDENCE_THRESHOLD=0.60
MAX_LATENCY_BUDGET_MS=2000
MAX_COST_PER_REQUEST=0.05
ENABLE_HUMAN_REVIEW=true
ENABLE_CACHE=true

# Database (PostgreSQL) - Required in later phases
POSTGRES_USER=jevflow
POSTGRES_PASSWORD=jevflow_dev
POSTGRES_DB=jevflow_telemetry
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jevflow:jevflow_dev@localhost:5432/jevflow_telemetry

# Cache & Rate Limiting (Redis) - Required in Phase 6
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS_PER_MINUTE=60
